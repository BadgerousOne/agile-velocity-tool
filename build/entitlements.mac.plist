<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for spawning child processes (ollama serve, ollama pull) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <false/>
  <!-- Allows outbound network connections (binary download, AI APIs) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Allows writing to user data directory (userData/ollama/) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Allows spawning child processes not started via fork/exec with hardened runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
