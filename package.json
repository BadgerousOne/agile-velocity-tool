{
  "name": "agile-velocity-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "electron-builder": {
    "appId": "com.agile-velocity-tool",
    "productName": "Agile Velocity Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "minimumSystemVersion": "13.0",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "extraResources": [
      { "from": "electron/splash.html", "to": "splash.html" }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite",
    "build": "electron-vite build",
    "build:standalone": "vite build --config vite.standalone.js",
    "build:dmg": "electron-vite build && electron-builder --universal",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "openai": "^4.52.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "vite": "^5.3.4",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
